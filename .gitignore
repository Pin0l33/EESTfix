# =========================
# EESTfix - Git Ignore
# =========================

# Dependencias
node_modules/

# Variables de entorno y configuraciones privadas
.env
.env.*
!.env.example

# Configuraciones de IDE
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Archivos temporales
*.tmp
*.temp
~*

# Caché
.cache/
.parcel-cache/

# PHP
vendor/

# Archivos locales de XAMPP
xampp/

# Bases de datos locales
*.sqlite
*.sqlite3

# Configuraciones locales
config.local.php

# Backups
*.bak
*.backup

# Archivos subidos por usuarios
uploads/*
!uploads/.gitkeep
!uploads/reportes/
uploads/reportes/*
!uploads/reportes/.gitkeep
